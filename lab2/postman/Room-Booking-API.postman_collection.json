{
  "info": {
    "name": "Room Booking API — lab1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Kolekcja do wszystkich pięciu zadań Room Booking API. Uruchom serwer: node lab1/server.js (z katalogu głównego repozytorium). Domyślny adres: http://localhost:3000. Uruchom całą kolekcję po kolei w Runnerze, 1 iteracja. Nie jest potrzebny osobny plik środowiska. Żądania 2.01 i 2.02 zapisują ID używane w folderach 4 i 5. Każdy pełny przebieg tworzy trzy nowe rezerwacje i anuluje pierwszą. Restart serwera usuwa dane; po restarcie uruchom kolekcję od początku. Odpowiedzi 400, 404 i 409 są oczekiwanym wynikiem scenariuszy błędów i powinny mieć zielone testy."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Adres działającego serwera bez końcowego ukośnika."
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string",
      "description": "Ustawiane automatycznie przez 2.01; używane przy anulowaniu."
    },
    {
      "key": "secondReservationId",
      "value": "",
      "type": "string",
      "description": "Ustawiane automatycznie przez 2.02; używane przy filtrowaniu."
    },
    {
      "key": "createdReservation",
      "value": "",
      "type": "string",
      "description": "Odpowiedź z 2.01, używana do sprawdzenia, że anulowanie zmienia tylko status."
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "    pm.test(\"Odpowiedź ma format JSON\", function () {",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "    });",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Sale",
      "description": "Zadanie 1: lista minimum czterech sal, pojedyncza sala i błąd 404.",
      "item": [
        {
          "name": "1.01 Wszystkie sale — 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms"
              ]
            },
            "description": "Zwraca co najmniej cztery sale z polami id, name i capacity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "    pm.test(\"Status HTTP 200\", function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    const responseBody = pm.response.json();",
                  "    pm.test(\"Lista zawiera minimum cztery sale\", function () {",
                  "        pm.expect(responseBody).to.be.an(\"array\");",
                  "        pm.expect(responseBody.length).to.be.at.least(4);",
                  "    });",
                  "    pm.test(\"Sale mają poprawne pola i unikalne ID\", function () {",
                  "        responseBody.forEach(function (room) {",
                  "            pm.expect(Number.isInteger(room.id) && room.id > 0).to.equal(true);",
                  "            pm.expect(room.name).to.be.a(\"string\").and.not.empty;",
                  "            pm.expect(room.capacity).to.be.a(\"number\").and.above(0);",
                  "        });",
                  "        pm.expect(new Set(responseBody.map(room => room.id)).size).to.equal(responseBody.length);",
                  "    });",
                  "})();"
                ]
              }
            }
          ]
        },
