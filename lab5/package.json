  "jest": {
    "testMatch": [
      "<rootDir>/tests/unit/**/*.spec.js",
      "<rootDir>/tests/integration/**/*.spec.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
