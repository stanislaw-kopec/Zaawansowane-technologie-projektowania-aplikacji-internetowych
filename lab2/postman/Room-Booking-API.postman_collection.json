    {
      "name": "2. Tworzenie rezerwacji i walidacja",
      "description": "Najpierw wyślij 2.01 i 2.02. Testy zapiszą ID do zmiennych kolekcji używanych w zadaniach 4 i 5.",
      "item": [
        {
          "name": "2.01 Utwórz rezerwację sali 1 — 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            },
            "description": "Zapisuje reservationId i pełną odpowiedź w createdReservation. Ta rezerwacja zostanie anulowana w folderze 5.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 1,\n  \"reservedBy\": \"Jan Kowalski\",\n  \"participants\": 20,\n  \"date\": \"2026-10-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "    pm.collectionVariables.unset(\"reservationId\");",
                  "    pm.collectionVariables.unset(\"createdReservation\");",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "    pm.test(\"Status HTTP 201\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    const responseBody = pm.response.json();",
                  "    pm.test(\"Serwer nadaje dodatnie, całkowite ID\", function () {",
                  "        pm.expect(Number.isInteger(responseBody.id) && responseBody.id > 0).to.equal(true);",
                  "    });",
                  "    pm.test(\"Zapisane dane i status CONFIRMED są poprawne\", function () {",
                  "        pm.expect(responseBody).to.deep.equal({",
                  "            ...JSON.parse(pm.request.body.raw),",
                  "            id: responseBody.id,",
                  "            status: \"CONFIRMED\"",
                  "        });",
                  "    });",
                  "    if (pm.response.code === 201 && Number.isInteger(responseBody.id) && responseBody.id > 0) {",
                  "        pm.collectionVariables.set(\"reservationId\", String(responseBody.id));",
                  "        pm.collectionVariables.set(\"createdReservation\", JSON.stringify(responseBody));",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        },
